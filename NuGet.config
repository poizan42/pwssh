<?xml version="1.0" encoding="utf-8"?>
<!--
  Restore sources for this repo, pinned so a clone behaves the same everywhere.

  The <clear /> is the point. A user-level NuGet.Config on the machine this was written on declared
  the nuget.org key twice and the second entry won, leaving https://www.nuget.org/api/v2/ (the
  retired OData gallery) as the only source; restores against it are slow or fail outright. Machine
  config also contributed two local folder sources with nothing to do with this project.

  Only tests/ restores anything at all: src/agent/PwsshAgent.csproj has no PackageReference, and the
  client compiles its C# with Add-Type rather than a build.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
